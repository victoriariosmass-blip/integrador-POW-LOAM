{
    "openapi": "3.0.0",
    "info": {
        "title": "API Gestión de Convenios UNLPam",
        "version": "1.0.0"
    },
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Iniciar sesión (web, por cookie)",
                "operationId": "222b2625838e3c57e017987f73598fda",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "gestor.fi@convenios.test"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Logueado"
                    },
                    "422": {
                        "description": "Credenciales incorrectas"
                    }
                }
            }
        },
        "/api/token": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Obtener token (app y Swagger)",
                "operationId": "7f9d971a531be31da6c059ca33920634",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "gestor.fi@convenios.test"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password"
                                    },
                                    "dispositivo": {
                                        "type": "string",
                                        "example": "swagger"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token y usuario"
                    },
                    "422": {
                        "description": "Credenciales incorrectas"
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Cerrar sesión",
                "operationId": "ad65cbbd4e9f201619eae184a5961a98",
                "responses": {
                    "204": {
                        "description": "Sesión cerrada"
                    }
                }
            }
        },
        "/api/user": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Usuario logueado",
                "operationId": "961ad57987905b44ae2e2f40b82e76de",
                "responses": {
                    "200": {
                        "description": "Usuario"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                }
            }
        },
        "/api/convenios": {
            "get": {
                "tags": [
                    "Convenios"
                ],
                "summary": "Listado de convenios",
                "operationId": "7c7b33a8b882ddab303b8586a35c0608",
                "parameters": [
                    {
                        "name": "estado",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "tipo",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "q",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Listado paginado"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                }
            },
            "post": {
                "tags": [
                    "Convenios"
                ],
                "summary": "Alta de convenio",
                "operationId": "407b6781f1be945a0d993b8e84cb916e",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "titulo",
                                    "tipo",
                                    "objeto"
                                ],
                                "properties": {
                                    "titulo": {
                                        "type": "string",
                                        "example": "Convenio de prueba"
                                    },
                                    "tipo": {
                                        "type": "string",
                                        "example": "marco_colaboracion"
                                    },
                                    "objeto": {
                                        "type": "string",
                                        "example": "Colaboración académica"
                                    },
                                    "unidad_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "fecha_firma": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "fecha_vencimiento": {
                                        "type": "string",
                                        "format": "date"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Creado en borrador"
                    },
                    "403": {
                        "description": "Tu rol no puede cargar convenios"
                    },
                    "422": {
                        "description": "Datos inválidos"
                    }
                }
            }
        },
        "/api/convenios/{id}": {
            "get": {
                "tags": [
                    "Convenios"
                ],
                "summary": "Ficha de un convenio",
                "operationId": "edb2ec181b68df5cdf8041a316aadddf",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Ficha"
                    },
                    "403": {
                        "description": "Sin permiso"
                    },
                    "404": {
                        "description": "No existe"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Token de POST /api/token",
                "scheme": "bearer"
            }
        }
    },
    "security": [
        {
            "sanctum": []
        }
    ],
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Convenios",
            "description": "Convenios"
        }
    ]
}