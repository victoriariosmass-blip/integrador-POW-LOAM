{
    "openapi": "3.0.0",
    "info": {
        "title": "API Gestión de Convenios UNLPam",
        "version": "1.0.0"
    },
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Iniciar sesión (web, por cookie)",
                "operationId": "222b2625838e3c57e017987f73598fda",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "gestor.fi@convenios.test"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Logueado"
                    },
                    "422": {
                        "description": "Credenciales incorrectas"
                    }
                }
            }
        },
        "/api/token": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Obtener token (app y Swagger)",
                "operationId": "7f9d971a531be31da6c059ca33920634",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "gestor.fi@convenios.test"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password"
                                    },
                                    "dispositivo": {
                                        "type": "string",
                                        "example": "swagger"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token y usuario"
                    },
                    "422": {
                        "description": "Credenciales incorrectas"
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Cerrar sesión",
                "operationId": "ad65cbbd4e9f201619eae184a5961a98",
                "responses": {
                    "204": {
                        "description": "Sesión cerrada"
                    }
                }
            }
        },
        "/api/user": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Usuario logueado",
                "operationId": "961ad57987905b44ae2e2f40b82e76de",
                "responses": {
                    "200": {
                        "description": "Usuario"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                }
            }
        },
        "/api/convenios": {
            "get": {
                "tags": [
                    "Convenios"
                ],
                "summary": "Listado de convenios",
                "operationId": "7c7b33a8b882ddab303b8586a35c0608",
                "parameters": [
                    {
                        "name": "estado",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "tipo",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "q",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Listado paginado"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                }
            },
            "post": {
                "tags": [
                    "Convenios"
                ],
                "summary": "Alta de convenio",
                "operationId": "407b6781f1be945a0d993b8e84cb916e",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "titulo",
                                    "tipo",
                                    "objeto"
                                ],
                                "properties": {
                                    "titulo": {
                                        "type": "string",
                                        "example": "Convenio de prueba"
                                    },
                                    "tipo": {
                                        "type": "string",
                                        "example": "marco_colaboracion"
                                    },
                                    "objeto": {
                                        "type": "string",
                                        "example": "Colaboración académica"
                                    },
                                    "unidad_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "fecha_firma": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "fecha_vencimiento": {
                                        "type": "string",
                                        "format": "date"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Creado en borrador"
                    },
                    "403": {
                        "description": "Tu rol no puede cargar convenios"
                    },
                    "422": {
                        "description": "Datos inválidos"
                    }
                }
            }
        },
        "/api/convenios/{id}": {
            "get": {
                "tags": [
                    "Convenios"
                ],
                "summary": "Ficha de un convenio",
                "operationId": "edb2ec181b68df5cdf8041a316aadddf",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Ficha"
                    },
                    "403": {
                        "description": "Sin permiso"
                    },
                    "404": {
                        "description": "No existe"
                    }
                }
            },
            "put": {
                "tags": [
                    "Convenios"
                ],
                "summary": "Editar borrador",
                "operationId": "d02cb97d139a19d680610200932a976b",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "version"
                                ],
                                "properties": {
                                    "version": {
                                        "description": "La que tenía el convenio al abrirlo",
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "titulo": {
                                        "type": "string",
                                        "example": "Convenio editado"
                                    },
                                    "objeto": {
                                        "type": "string",
                                        "example": "Nuevo objeto"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Convenio editado"
                    },
                    "403": {
                        "description": "Sin permiso o no está en borrador"
                    },
                    "409": {
                        "description": "Otro usuario lo cambió mientras se editaba"
                    },
                    "422": {
                        "description": "Datos inválidos"
                    }
                }
            }
        },
        "/api/convenios/{id}/enviar-revision": {
            "post": {
                "tags": [
                    "Circuito"
                ],
                "summary": "Enviar a revisión (borrador -> revision)",
                "operationId": "d315de4c93ba9d6ab940241f51b7d323",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Convenio en revisión"
                    },
                    "403": {
                        "description": "Sin permiso o estado incorrecto"
                    }
                }
            }
        },
        "/api/convenios/{id}/aprobar": {
            "post": {
                "tags": [
                    "Circuito"
                ],
                "summary": "Aprobar (revision -> aprobado)",
                "operationId": "a6d013af433647fef97c64f579f3a460",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "fundamento": {
                                        "type": "string",
                                        "example": "Cumple con lo requerido"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Convenio aprobado"
                    },
                    "403": {
                        "description": "Sin permiso o estado incorrecto"
                    }
                }
            }
        },
        "/api/convenios/{id}/devolver": {
            "post": {
                "tags": [
                    "Circuito"
                ],
                "summary": "Devolver con observaciones (revision -> borrador)",
                "operationId": "60e8dd90e0cbdcefef0116532e7c77ee",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "observaciones"
                                ],
                                "properties": {
                                    "observaciones": {
                                        "type": "string",
                                        "example": "Falta la resolución del Consejo"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Convenio devuelto a borrador"
                    },
                    "403": {
                        "description": "Sin permiso o estado incorrecto"
                    },
                    "422": {
                        "description": "Faltan las observaciones"
                    }
                }
            }
        },
        "/api/convenios/{id}/rescindir": {
            "post": {
                "tags": [
                    "Circuito"
                ],
                "summary": "Rescindir (firmado -> rescindido)",
                "operationId": "295197b855305ac2329f803df0dfccee",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "fundamento"
                                ],
                                "properties": {
                                    "fundamento": {
                                        "type": "string",
                                        "example": "Rescisión de común acuerdo"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Convenio rescindido"
                    },
                    "403": {
                        "description": "Sin permiso o estado incorrecto"
                    },
                    "422": {
                        "description": "Falta el fundamento"
                    }
                }
            }
        },
        "/api/convenios/{id}/archivar": {
            "post": {
                "tags": [
                    "Circuito"
                ],
                "summary": "Archivar (firmado o rescindido -> archivado)",
                "operationId": "18b64e1ed0b65ed2d7c4279f17f35225",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "fundamento": {
                                        "type": "string",
                                        "example": "Vencido sin renovación"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Convenio archivado"
                    },
                    "403": {
                        "description": "Sin permiso o estado incorrecto"
                    }
                }
            }
        },
        "/api/convenios/{id}/asignar-revisor": {
            "post": {
                "tags": [
                    "Circuito"
                ],
                "summary": "Asignar revisor (solo admin)",
                "operationId": "98eac89a01ec0a2392700e85967aac1f",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "revisor_id"
                                ],
                                "properties": {
                                    "revisor_id": {
                                        "type": "integer",
                                        "example": 6
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Revisor asignado"
                    },
                    "403": {
                        "description": "Sin permiso"
                    },
                    "422": {
                        "description": "El usuario no es revisor"
                    }
                }
            }
        },
        "/api/resumen": {
            "get": {
                "tags": [
                    "Convenios"
                ],
                "summary": "Métricas de inicio y últimos 10 movimientos",
                "operationId": "9862aeab79898bf62a4985ccfaa71715",
                "responses": {
                    "200": {
                        "description": "Métricas"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                }
            }
        },
        "/api/unidades": {
            "get": {
                "tags": [
                    "Convenios"
                ],
                "summary": "Unidades (para elegir en el alta de convenio)",
                "operationId": "6a3f83442bf5553e050e66760a81b0cd",
                "responses": {
                    "200": {
                        "description": "Lista de unidades"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Token de POST /api/token",
                "scheme": "bearer"
            }
        }
    },
    "security": [
        {
            "sanctum": []
        }
    ],
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Convenios",
            "description": "Convenios"
        },
        {
            "name": "Circuito",
            "description": "Circuito"
        }
    ]
}